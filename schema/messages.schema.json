{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arclab-kmu/mycobot-link/blob/main/schema/messages.schema.json",
  "title": "mycobot-link messages, protocol 1",
  "description": "One JSON object per line over one TCP connection. This schema fixes the structure only. Joint limits, jump limits, speed caps and the gate are the arm server's checks, not the schema's.",
  "oneOf": [
    { "$ref": "#/$defs/brain_to_arm" },
    { "$ref": "#/$defs/arm_to_brain" }
  ],
  "$defs": {
    "id": {
      "description": "Chosen by the brain, echoed in the reply. Unique per connection.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "speed": {
      "description": "pymycobot speed, 1-100. Its deg/s meaning is unmeasured.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "joint_angles_deg": {
      "description": "J1..J6 in degrees, the SDK's unit.",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 6,
      "maxItems": 6
    },

    "brain_to_arm": {
      "oneOf": [
        { "$ref": "#/$defs/ping" },
        { "$ref": "#/$defs/enable" },
        { "$ref": "#/$defs/disable" },
        { "$ref": "#/$defs/stop" },
        { "$ref": "#/$defs/move_joints" },
        { "$ref": "#/$defs/gripper" }
      ]
    },
    "ping": {
      "description": "Heartbeat. No reply. Any line from the brain resets the arm's watchdog.",
      "type": "object",
      "properties": { "type": { "const": "ping" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "enable": {
      "description": "Open the gate. Refused without a fresh joint reading.",
      "type": "object",
      "properties": { "type": { "const": "enable" }, "id": { "$ref": "#/$defs/id" } },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "disable": {
      "description": "Close the gate. Does not stop a move already sent.",
      "type": "object",
      "properties": { "type": { "const": "disable" }, "id": { "$ref": "#/$defs/id" } },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "stop": {
      "description": "stop() on the arm, then close the gate. Accepted with the gate closed.",
      "type": "object",
      "properties": { "type": { "const": "stop" }, "id": { "$ref": "#/$defs/id" } },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "move_joints": {
      "description": "send_angles(angles_deg, speed), if the arm server's checks pass.",
      "type": "object",
      "properties": {
        "type": { "const": "move_joints" },
        "id": { "$ref": "#/$defs/id" },
        "angles_deg": { "$ref": "#/$defs/joint_angles_deg" },
        "speed": { "$ref": "#/$defs/speed" }
      },
      "required": ["type", "id", "angles_deg", "speed"],
      "additionalProperties": false
    },
    "gripper": {
      "description": "set_gripper_value(value, speed). Which end of 0-100 is open is unverified.",
      "type": "object",
      "properties": {
        "type": { "const": "gripper" },
        "id": { "$ref": "#/$defs/id" },
        "value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "speed": { "$ref": "#/$defs/speed" }
      },
      "required": ["type", "id", "value", "speed"],
      "additionalProperties": false
    },

    "arm_to_brain": {
      "oneOf": [
        { "$ref": "#/$defs/hello" },
        { "$ref": "#/$defs/reply" },
        { "$ref": "#/$defs/state" }
      ]
    },
    "hello": {
      "description": "First line on every connection.",
      "type": "object",
      "properties": {
        "type": { "const": "hello" },
        "protocol": { "const": 1 },
        "server": { "type": "string" },
        "live": { "type": "boolean" },
        "watchdog_ms": { "type": "integer", "minimum": 1 },
        "state_hz": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["type", "protocol", "server", "live", "watchdog_ms", "state_hz"],
      "additionalProperties": false
    },
    "reply": {
      "description": "Accepted or rejected. Accepted means sent to the arm, not reached. id is null when the request was too malformed to carry one.",
      "type": "object",
      "properties": {
        "type": { "const": "reply" },
        "id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "ok": { "type": "boolean" },
        "error": { "type": "string" }
      },
      "required": ["type", "id", "ok"],
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"] },
      "else": { "not": { "required": ["error"] } },
      "additionalProperties": false
    },
    "state": {
      "description": "Latest-value telemetry at state_hz. angles_deg is null when the last read failed; read_age_ms is the age of the newest good reading.",
      "type": "object",
      "properties": {
        "type": { "const": "state" },
        "seq": { "type": "integer", "minimum": 0 },
        "angles_deg": { "oneOf": [{ "$ref": "#/$defs/joint_angles_deg" }, { "type": "null" }] },
        "read_age_ms": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "gate_open": { "type": "boolean" },
        "gate_reason": { "type": "string" },
        "live": { "type": "boolean" }
      },
      "required": ["type", "seq", "angles_deg", "read_age_ms", "gate_open", "gate_reason", "live"],
      "additionalProperties": false
    }
  }
}
